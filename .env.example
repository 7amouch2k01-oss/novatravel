# NOVA Travel Agent — Environment Variables
#
# Required for NOVA: get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Hotelbeds evaluation API (server-side only; never expose these in VITE_ variables)
# HOTELBEDS_API_KEY=
# HOTELBEDS_API_SECRET=
# HOTELBEDS_ENV=test
# Hotelbeds Booking API now requires an mTLS client certificate for search,
# check-rate, booking, and cancellation operations. Keep the private key local.
# HOTELBEDS_MTLS_CERT_PATH=
# HOTELBEDS_MTLS_KEY_PATH=
# HOTELBEDS_TEST_HOTEL_CODES=9589,9590,9632,13813,15284,15380
# HOTELBEDS_SANDBOX_CHECK_IN=2026-11-10
# HOTELBEDS_SANDBOX_CHECK_OUT=2026-11-12
